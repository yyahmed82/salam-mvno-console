# local/.env.example — copy to local/.env and adjust the user/port for YOUR Postgres.
# Nothing here is a secret: it is all localhost. local/.env itself is gitignored.

PORT=3000
TZ=UTC                      # the app stores UTC in timestamp-without-tz columns; do not change

# ---- the databases restored by local/restore-local.sh --------------------------------------
# sda_ops_local carries BOTH schemas, exactly like prod: sda_ops has `public` (prod read model)
# and `beta` (B2C / Salam Home). db.js strips the Prisma-style `?schema=` and pins
# search_path=<schema>,public per connection - so keep the query string.
CONSOLE_DATABASE_URL=postgres://CHANGEME@127.0.0.1:5432/unified_console_local
SOURCE_DATABASE_URL=postgres://CHANGEME@127.0.0.1:5432/salam_source_local
OPS_DATABASE_URL=postgres://CHANGEME@127.0.0.1:5432/sda_ops_local?schema=public
OPS_BETA_DATABASE_URL=postgres://CHANGEME@127.0.0.1:5432/sda_ops_local?schema=beta
PG_APP_NAME=salam_unified_local

# ---- who you are locally --------------------------------------------------------------------
CONSOLE_ADMIN_USER=y.yahmed.sns@salam.sa
CONSOLE_SUPER_ADMINS=y.yahmed.sns@salam.sa
ROOT_ADMINS=y.yahmed.sns@salam.sa

# ---- everything that reaches OUT stays OFF locally -------------------------------------------
# No SMTP: the sign-in code comes back in the API response instead of an e-mail (otp.js dev mode),
# and the console prints it for you. Leaving these unset is deliberate - it also means a local run
# can never mail a real person.
# SMTP_HOST=
HEALTHCHECK_INTERVAL_MIN=0    # no health mails from a laptop
AGENT_LOG_ENABLED=0           # the two AI agents idle unless you point LLM at something
AGENT_INCIDENT_ENABLED=0
PROD_DATABASE_URL=            # never let a laptop run the prod-sync scheduler
API_LOG_HOSTS=                # no SSH log collectors
ZIPKIN_HOSTS=
OSB_LOG_URL=
UPG_DATABASE_URL=
SN_URL=

# ---- optional: Yusr / the agents against a local model ---------------------------------------
# Install Ollama on the Mac (brew install ollama && ollama pull llama3.1) then uncomment:
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# AGENT_LOG_ENABLED=1
# AGENT_INCIDENT_ENABLED=1
