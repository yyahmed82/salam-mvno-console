# Salam Digital Console — /apps/console/.env on 152  (chmod 600; NEVER in git)
# Copy to /apps/console/.env and fill values on the box. Keys only here.

# ── Core (required) ───────────────────────────────────────────────────────────
PORT=4600
# Server 152's system clock is Asia/Riyadh, but the app stores timestamps as UTC in
# `timestamp WITHOUT time zone` columns. node-pg parses those in the PROCESS timezone, so the
# console MUST run as UTC or every timestamp is read 3h early (dashboard shows stale/zero data).
# Also set in ecosystem.prod.config.js — keep both.
TZ=UTC
# App databases. RECOMMENDED: both on prod PG 172.31.15.121 (DBA creates them; see DEPLOY.md §2)
#   SOURCE = replica schema the console reads (salam data)   CONSOLE = the console's own writable DB
SOURCE_DATABASE_URL=postgres://<user>:<pass>@172.31.15.121:5432/<salam_replica_db>
CONSOLE_DATABASE_URL=postgres://<user>:<pass>@172.31.15.121:5432/mvno_console

# ── Prod-sync (in-container scheduler; only if SOURCE is a replica, not prod itself) ──
# Read-only prod account. If SOURCE_DATABASE_URL points directly at the prod data, LEAVE UNSET.
# NOTE 2026-08-05: 172.31.43.123 is a prod REPORTING REPLICA and was found frozen (3h behind its
# own clock). If it stalls again, repoint this at a fresher source (the DB the admin app reads),
# then: pm2 delete salam-console && pm2 start ecosystem.prod.config.js && pm2 save
# Verify with: node healthcheck.cjs  → section 2d must show "Xm behind now" in single digits.
PROD_DATABASE_URL=
UPSTREAM_STALE_MIN=60      # minutes before high-volume tables (payments/orders) raise DATA FROZEN
PROD_SYNC_INTERVAL_MIN=5
PROD_SYNC_OVERLAP_HOURS=1

