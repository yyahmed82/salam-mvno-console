# ── Digital-API traffic · PREFERRED: SSH log collector (apiLogCollector.js) ──────────────
# The console pulls api_logger.production.log increments over SSH from the TWO api hosts
# ("server 17" and "server 18" — set the real IPs) into its own Postgres table
# api_traffic_events (7-day rolling retention). Monitoring + api_latency_p95 /
# api_technical_fail_rate then read the console DB — no dependency on the ops cron/Grafana chain.
# Setting API_LOG_HOSTS switches apiTraffic.js to collector mode; unset = MySQL fallback below.
#
# HOST-SIDE PREREQUISITES (once per api host — ask the salam_api owner):
#   1) a READ-ONLY account on 17/18 that can read the log, e.g. on each api host as root:
#        useradd -m -s /bin/bash consolero
#        usermod -aG <log-group-of-/www/app/salam_api/shared/log> consolero   # or setfacl:
#        setfacl -m u:consolero:rX /www/app/salam_api/shared/log
#        setfacl -m u:consolero:r  /www/app/salam_api/shared/log/api_logger.production.log
#   2) key trust FROM 152 (as the PM2 user on 152):
#        ssh-keygen -t ed25519 -f ~/.ssh/api_log_ed25519 -N ''
#        ssh-copy-id -i ~/.ssh/api_log_ed25519.pub consolero@<server17-ip>
#        ssh-copy-id -i ~/.ssh/api_log_ed25519.pub consolero@<server18-ip>
#        ssh -i ~/.ssh/api_log_ed25519 consolero@<server17-ip> 'wc -c < /www/app/salam_api/shared/log/api_logger.production.log'
#   3) firewall: 152 → 17/18 port 22/tcp may need a SOC ticket (connectivity-check.cjs tests it):
#        ALLOW 172.31.38.152 -> <server17-ip>:22/tcp   # api-log collector
#        ALLOW 172.31.38.152 -> <server18-ip>:22/tcp   # api-log collector
API_LOG_HOSTS=172.31.43.17,172.31.43.18
API_LOG_USER=consolero
API_LOG_KEY=/home/<pm2user>/.ssh/api_log_ed25519
API_LOG_PATH=/www/app/salam_api/shared/log/api_logger.production.log
API_LOG_INTERVAL_MIN=1       # pull cadence (minutes)
# App error-log collector (api_error_logger.production.log, same hosts/key — powers the
# Monitoring "App errors / IP rate-limiting" panel; -704 = IpRetrial blocks). Auto-enabled
