# ---- performance (7 Oct 2026) ------------------------------------------------------------------
# GET /api/perf (admin tools) = where the time goes: routes, event-loop lag, pool waits, slow queries.
# PERF_SLOW_MS=1500            # a request slower than this is logged as [SLOW]
# PERF_SLOW_QUERY_MS=2000      # a pg query slower than this is kept in the report
# PERF_DISABLED=1              # switch the instrumentation off
# STATIC_FAST_DISABLED=1       # serve the web files the old way (no gzip, max-age=0)
# STATIC_GZ_MAX_MB=64          # in-memory cap for the gzipped copies of the web files
# INFRA_FLOWS_RETENTION_DAYS=2 # per-minute connection samples kept (every read is a 15-minute window)
