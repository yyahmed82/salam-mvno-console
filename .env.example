# Read-only prod replica sync — set on the host, loaded via docker-compose env_file.
# URL-encode special chars in the password (e.g. '#' -> %23, '@' -> %40).
PROD_DATABASE_URL=postgres://user:REDACTED@host:5432/db?sslmode=require
# Optional integrations (leave unset to disable):
# SN_URL= / SN_USER= / SN_PASS=            ServiceNow (read-only ticket correlation)
# TAP_SECRET_KEY=                          Tap reconciliation
# SEMATI_PROBE_LOGIN_URL= / _ELIG_URL=     Semati synthetic canary
# SMS_URL= / SMS_APPSID=                   Unifonic SMS paging

# --- OSB integration log (BSS read-path 1500 / OSB-382000 faults; MySQL logs.uil_logs) ---
# Inert until set. Point at the OSB/UIL logging DB to light up the live OSB fault tile + alerting.
# OSB_LOG_URL=mysql://user:pass@<osb-mysql-host>:3306/logs   # real host from OSB/BSS team — NOT 172.31.38.145 (that's FTTH/fixed, not MVNO)
# Or individual parts: OSB_DB_HOST=<osb-mysql-host>  OSB_DB_PORT=3306  OSB_DB_USER=  OSB_DB_PASSWORD=  OSB_DB_NAME=logs
# Schema overrides (defaults shown) — adjust to the real uil_logs columns:
# OSB_LOG_TABLE=uil_logs  OSB_LOG_TIME_COL=insert_date_time  OSB_LOG_CODE_COL=response_code
# OSB_LOG_MSG_COL=response_message  OSB_LOG_API_COL=api_name  OSB_FAULT_CODE=1500
# Alert probe: OSB_PROBE_WINDOW_MIN=10  OSB_FAULT_ALERT_THRESHOLD=300  OSB_PROBE_INTERVAL_MIN=5  OSB_PROBE_AUTO=1
